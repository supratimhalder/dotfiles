# i3 config

default_border pixel 2
default_floating_border pixel 2
for_window [class=".*"] border pixel 2

set $mod Mod4

font pango:monospace 11

floating_modifier $mod
tiling_drag modifier titlebar

# Programs
bindsym $mod+Return exec alacritty
bindsym $mod+e exec pcmanfm
bindsym $mod+b exec librewolf
bindsym $mod+d exec --no-startup-id dmenu_run

# Close window
bindsym $mod+Shift+q kill

# Focus (vim keys and arrows)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move windows
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split direction
bindsym $mod+semicolon split h
bindsym $mod+v split v

# Fullscreen, layouts, floating
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+Shift+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Reload, restart, exit
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# Resize mode
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Volume (PipeWire via pactl)
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle

# Look
default_border pixel 2
hide_edge_borders smart
gaps inner 0

# Floating rules for dialogs
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

# Startup
exec_always --no-startup-id xrandr --output HDMI-2 --mode 1920x1080 --rate 120

# Bar
bar {
    separator_symbol " | "
    status_command ~/.local/bin/i3status-mic
    position top
    height 22
    workspace_min_width 22
    tray_output none
    font pango:monospace 10
}

# Assign workspaces at login
assign [class="librewolf"] number 1
assign [class="Alacritty"] number 2

# Launch at login
exec --no-startup-id librewolf
exec --no-startup-id alacritty
exec_always --no-startup-id picom -b
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec_always --no-startup-id feh --bg-fill /usr/share/backgrounds/wallpaper.jpg

# Prevent sleep
exec_always --no-startup-id xset s off
exec_always --no-startup-id xset -dpms
exec_always --no-startup-id xset s noblank

# Screenshots: save to file
bindsym Print exec --no-startup-id ~/.local/bin/screenshot full file
bindsym Shift+Print exec --no-startup-id ~/.local/bin/screenshot area file
bindsym Ctrl+Print exec --no-startup-id ~/.local/bin/screenshot window file

# Screenshots: copy to clipboard
bindsym $mod+Print exec --no-startup-id ~/.local/bin/screenshot full clip
bindsym $mod+Shift+Print exec --no-startup-id ~/.local/bin/screenshot area clip
bindsym $mod+Ctrl+Print exec --no-startup-id ~/.local/bin/screenshot window clip

# System volume
bindsym $mod+F2 exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ && killall -USR1 i3status
bindsym $mod+F1 exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && killall -USR1 i3status
bindsym $mod+F9 exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && killall -USR1 i3status

# Microphone volume
bindsym $mod+F4 exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+ && killall -USR1 i3status
bindsym $mod+F3 exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%- && killall -USR1 i3status
bindsym $mod+F10 exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && killall -USR1 i3status
